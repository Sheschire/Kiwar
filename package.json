{
  "name": "kiwar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @kiwar/client dev",
    "build": "pnpm --filter @kiwar/client build",
    "preview": "pnpm --filter @kiwar/client preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "balance": "pnpm --filter @kiwar/balance balance",
    "build:functions": "node scripts/build-functions.mjs",
    "test:db": "supabase/tests/run.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
